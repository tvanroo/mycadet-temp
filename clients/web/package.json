{
  "name": "@mycadet/web",
  "version": "0.12.8",
  "type": "module",
  "description": "Pre-built web SPA for the Cadet Assistant",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "bun run openapi-ts && node ../../packages/assistant-ui/scripts/copy-skill-assets.mjs",
    "dev": "bun --bun vite",
    "prebuild": "node ../../packages/assistant-ui/scripts/copy-skill-assets.mjs",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "lint": "eslint",
    "pretypecheck": "bun run openapi-ts",
    "typecheck": "bunx tsc --noEmit",
    "openapi-ts": "cd ../../packages/assistant-ui && bun run openapi-ts",
    "android:sync": "bunx --bun cap sync android",
    "android:run": "bun run scripts/run-android.ts",
    "android:open": "bun run android:sync && bunx --bun cap open android",
    "ios:setup": "bunx cap sync ios && cd ../ios/App && xcodegen generate --spec project.yml",
    "ios:open": "bun run ios:setup && open ../ios/App/App.xcodeproj",
    "test": "bun test",
    "test:edge-swipe:browser": "bun scripts/test-edge-swipe-browser.ts",
    "test:ci": "bun scripts/run-tests.ts"
  },
  "dependencies": {
    "@capacitor/keyboard": "8.0.5",
    "@mycadet/assistant-ui": "workspace:*",
    "@mycadet/environments": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4",
    "@googleapis/androidpublisher": "36.0.0",
    "@mycadet/shared": "workspace:*",
    "@types/bun": "1.3.14",
    "eslint": "10.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vite": "8.0.11"
  }
}
