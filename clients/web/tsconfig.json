{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["../../packages/assistant-ui/src/*"],
      "@mycadet/assistant-ui/*": ["../../packages/assistant-ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/assistant-ui/src/**/*.d.ts",
    "capacitor.config.ts"
  ],
  "exclude": ["dist/**", "node_modules/**"]
}
